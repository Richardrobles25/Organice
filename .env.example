# Copia este archivo como .env y llena los valores. El .env nunca se sube.
# Para Supabase local: con Docker abierto corre `npx supabase start` y copia "API_URL" y "ANON_KEY"
# de `npx supabase status -o env` (la URL local es http://127.0.0.1:54321).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
